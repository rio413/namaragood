# Copy to .env for local runs. In GitHub these live under
# Settings › Secrets and variables › Actions. Never commit real values.

# Notion integration key (secret) and the Places database ID (not secret).
NOTION_TOKEN=
NOTION_DATABASE_ID=95ffbb34b7d141678961ec3c9ba9b615

# Server-side key, restricted to "Places API (New)". Used at build time only.
GOOGLE_PLACES_KEY=

# Browser key, restricted by HTTP referrer to your domain and to "Maps JavaScript API".
PUBLIC_GOOGLE_MAPS_KEY=
# Map ID with the dark NAMARA style (Cloud Console › Map management). DEMO_MAP_ID works for testing.
PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID

# Translations.
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-sonnet-5-5

# Public address of the site, used for canonical URLs, hreflang and the sitemap.
SITE_URL=https://namaragood.com

# Set to 1 to include Draft places (preview builds only, never for the live site).
INCLUDE_DRAFTS=0
