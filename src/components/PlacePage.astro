---
import { PLACES, UI, tag, href, num, subline, textIn, drawingFor, svg, mapsLink, MAPS_KEY, MAP_ID, MAPS_LANG, esc } from '../lib/site.js';
import { PHRASE_ORDER } from '../i18n/ui.js';
import { cardPath } from '../lib/cardtext.js';
const { lang, place: p } = Astro.props;
const u = UI[lang];
const d = drawingFor(p);
const note = textIn(p.note, lang);
const tip = textIn(p.tip, lang);
const join = (arr) => arr.map(v => tag(v, lang)).join(' · ');

const facts = [
  [u.what, join(p.specs.length ? p.specs : p.types)],
  [u.where, [tag(p.area, lang), p.price].filter(Boolean).join(' · ')],
  [u.booking, p.reservation ? tag(p.reservation, lang) : ''],
  [u.know, join([...p.prac, ...p.dietary])],
  [u.fGood, join(p.good)],
].filter(([, v]) => v);

const jaName = p.nameJa || p.name;
const ICONS = {
  taxi: '<path d="M3 15l2-6h14l2 6v4H3z"/><circle cx="7.5" cy="17" r="1.5"/><circle cx="16.5" cy="17" r="1.5"/><path d="M9 9V6h6v3"/>',
  where: '<path d="M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z"/><path d="M10.5 9a1.5 1.5 0 1 1 2 1.4c-.5.2-.5.6-.5 1.1"/>',
  want: '<path d="M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z"/><circle cx="12" cy="10" r="2"/>',
  table: '<circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><path d="M3 20c0-4 2.5-6 5-6s5 2 5 6M11 20c0-4 2.5-6 5-6s5 2 5 6"/>',
  card: '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 15h4"/>',
  menu: '<path d="M6 3h12v18H6z"/><path d="M9 8h6M9 12h6M9 16h4"/>',
};
// Which phrases show the shop name and address under them.
const WITH_PLACE = new Set(['taxi', 'where', 'want']);
const phrases = PHRASE_ORDER.map(k => ({
  k, label: u.phrases[k].label,
  ja: k === 'table' ? UI.en.phrases.table.ja(2) : UI.en.phrases[k].ja,
  place: WITH_PLACE.has(k),
}));
const others = PLACES.filter(x => x.id !== p.id && x.area === p.area).slice(0, 4);
const nearby = others.length ? others : PLACES.filter(x => x.id !== p.id).slice(0, 4);
---
<section class="top phead">
  <div class="wrap">
    <a class="m" href={href(lang)} style="font-size:12px;text-decoration:none;display:inline-block;padding:4px 0 10px">← {u.back}</a>
    <div class="grid">
      <div class="art"><Fragment set:html={svg(d, 'class="dr"')} /></div>
      <div>
        <div class="ptitle"><h1 class="d">{p.name}</h1></div>
        {p.nameJa && p.nameJa.toLowerCase() !== p.name.toLowerCase() && <span class="ja" lang="ja">{p.nameJa}</span>}
        <button type="button" class="sharecta m" data-openshare>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18"/><path d="M8 15h8M8 18h5"/><circle cx="12" cy="9" r="3"/></svg>
          {u.shareCard}
        </button>
      </div>
    </div>
  </div>
</section>

<div class="wrap pbody">
  <div>
    <dl class="facts">
      {facts.map(([k, v]) => <div><dt class="d ol">{k}</dt><dd class="m">{v}</dd></div>)}
    </dl>
    <article class="note" lang={note.translated ? undefined : 'en'}>
      {note.paras.map((para, i) => <p class={i === 0 ? 'lead' : undefined} set:html={para} />)}
      {tip.paras.length > 0 && <div class="tip"><strong class="m">{u.tip}</strong>{tip.paras.map(t => <p set:html={t} />)}</div>}
      <div class="sig">
        <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="20" cy="15" r="7" fill="#E8C15A"/><path d="M7 36c2-8 7-12 13-12s11 4 13 12"/></svg>
        <span class="m">{u.byline}{p.lastChecked && <><br>{u.lastChecked}: {p.lastChecked}</>}</span>
      </div>
      {note.translated && <p class="ainote">{u.aiNote}</p>}
    </article>
  </div>

  <div class="side">
    <section class="blk" aria-labelledby="say" id="phrases" data-name={jaName} data-addr={p.addressJa}>
      <h2 id="say" class="d ol">{u.sayIt}</h2>
      <div class="say m">
        {phrases.map((ph, i) => (
          <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-k={ph.k} data-ja={ph.ja} data-place={ph.place ? '1' : ''}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[ph.k]} />
            {ph.label}
          </button>
        ))}
      </div>
      <div class="stepper m" data-stepper hidden>
        <span>{u.people}</span>
        <button type="button" data-step="-1" aria-label="−">−</button>
        <output data-n>2</output>
        <button type="button" data-step="1" aria-label="+">+</button>
      </div>
      <button type="button" class="card-ja" data-cardja aria-describedby="sayhint">
        <span class="big" lang="ja" data-big>{phrases[0].ja}</span>
        <span class="addr" lang="ja" data-addr>{jaName}{p.addressJa && <><br>{p.addressJa}</>}</span>
        <span class="hint m" id="sayhint">{u.showDriver}</span>
      </button>
    </section>

    <section class="blk" aria-labelledby="find">
      <h2 id="find" class="d ol">{u.findIt}</h2>
      {p.lat != null && MAPS_KEY && (
        <div class="minimap" data-minimap data-lat={p.lat} data-lng={p.lng} data-maps-key={MAPS_KEY} data-map-id={MAP_ID} data-maps-lang={MAPS_LANG[lang]} data-svg={svg(d, 'class="dr"')} role="img" aria-label={`${u.map}: ${p.name}`}></div>
      )}
      {p.addressJa && <p class="addrline" style="margin:0"><span lang="ja">{p.addressJa}</span></p>}
      <a class="btn solid big" href={mapsLink(p)} target="_blank" rel="noopener">{u.openMaps} <span aria-hidden="true">↗</span></a>
      <div class="two m">
        <button type="button" class="btn" data-save={p.slug} aria-pressed="false" data-on={u.savedBtn} data-off={u.save}>♡ <span>{u.save}</span></button>
        <button type="button" class="btn" data-openshare>{u.share}</button>
      </div>
    </section>

    <section class="blk more" aria-labelledby="more">
      <h2 id="more" class="d ol">{u.theList}</h2>
      <ol class="rows">
        {nearby.map(x => (
          <li><a class="row" href={href(lang, 'place', x.slug)} style="grid-template-columns:56px minmax(0,1fr) 14px">
            <Fragment set:html={svg(drawingFor(x), 'class="dr"')} />
            <span><span class="nm d" style="font-size:15px">{x.name}</span><span class="sub">{subline(x, lang)}</span></span>
            <svg width="12" height="8" viewBox="0 0 14 9" aria-hidden="true" style="transform:rotate(-90deg)"><path d="M0 0h14L7 9z" fill="currentColor"/></svg>
          </a></li>
        ))}
      </ol>
    </section>
  </div>
</div>

<dialog class="sheet sharesheet" id="share" aria-labelledby="sh" data-title={`${p.name} | NAMARA GOOD`} data-copied={u.copied} data-file={p.slug}>
  <div class="sheet-in">
    <div class="sheet-head"><h2 id="sh" class="d">{u.shareTitle}</h2><button type="button" data-closeshare aria-label="Close">×</button></div>
    <div class="sheet-body">
      <div class="seg m sizes" role="group">
        {(['post', 'story', 'square']).map((sz, i) => <button type="button" data-size={sz} data-src={cardPath(lang, p.slug, sz)} aria-pressed={i === 0 ? 'true' : 'false'}>{u[sz]}</button>)}
      </div>
      <div class="cardprev"><img src={cardPath(lang, p.slug, 'post')} alt={`${p.name}: ${u.shareCard}`} data-cardimg width="1080" height="1440" loading="lazy" decoding="async"></div>
      <p class="hint">{u.saveHint}</p>
    </div>
    <div class="sheet-foot two m" style="grid-template-columns:1fr 1fr">
      <button type="button" class="btn solid" data-shareimg hidden>{u.shareImage}</button>
      <a class="btn solid" data-saveimg href={cardPath(lang, p.slug, 'post')} download={`namaragood-${p.slug}.png`}>{u.saveImage}</a>
      <button type="button" class="btn" data-copylink>{u.copyLink}</button>
    </div>
  </div>
</dialog>

<button type="button" class="full" id="full" hidden aria-label={u.tapClose}>
  <span class="big" lang="ja" data-fbig></span>
  <span class="addr" lang="ja" data-faddr></span>
  <span class="hint m">{u.tapClose}</span>
</button>
